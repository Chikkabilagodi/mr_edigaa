rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // User Settings Subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Chat Sessions Subcollection
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);

        // Messages inside Chat Session
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isValidId(messageId);
        }
      }
    }
  }
}
